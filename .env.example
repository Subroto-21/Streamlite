# Copy this file to `.env` and fill in the values. `.env` is gitignored.

# Spotify now-playing widget (optional).
# Register an app at https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=

# Feature-request & Support form delivery via Web3Forms (https://web3forms.com).
# This is a PUBLIC submission key (safe to ship in the frontend), not a secret.
# Get one free: enter your email at https://web3forms.com — submissions are
# emailed to that address. Without it, the forms show a "not configured" error.
VITE_WEB3FORMS_ACCESS_KEY=93b4aa68-d36e-4dd9-a3bd-37ba5fdee519
